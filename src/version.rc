#include <winver.h>
#include <windows.h>
#include "version.hpp"

1 VERSIONINFO
FILEVERSION BINHACK64_VERSION_RC
PRODUCTVERSION BINHACK64_VERSION_RC
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP

BEGIN

	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040C04E4"
		BEGIN
			VALUE "Comments", "Modernized 64-bit BINHACK clone\0"
			VALUE "CompanyName", "FamilyGuy and contributors\0"
			VALUE "FileDescription", BINHACK64_DESCRIPTION "\0"
			VALUE "FileVersion", BINHACK64_VERSION
			VALUE "InternalName", BINHACK64_NAME ".exe\0"
			VALUE "LegalCopyright", "GNU General Public License v3\0"
			VALUE "OriginalFilename", BINHACK64_NAME ".exe\0"
			VALUE "ProductName", "BINHACK64\0"
			VALUE "ProductVersion", BINHACK64_VERSION
		END
	END

	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x1009, 0x04E4
	END

END
